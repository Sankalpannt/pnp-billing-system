{
  "name": "pnp-tech-traders-billing",
  "version": "1.0.7",
  "description": "Billing & Invoice Management Desktop Software for PNP TECH TRADERS",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview --port 3000 --open",
    "electron": "electron .",
    "app:dev": "concurrently \"vite\" \"wait-on http://localhost:3000 && electron .\"",
    "app:build": "npm run build && npx electron-builder",
    "app:publish": "npm run build && node scripts/publish.cjs"
  },
  "keywords": [],
  "author": "PNP TECH TRADERS",
  "license": "ISC",
  "build": {
    "appId": "com.pnptechtraders.billingsoftware",
    "productName": "PNP TECH TRADERS Billing Software",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "payment qr/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PNP TECH TRADERS Billing"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Sankalpannt",
        "repo": "pnp-billing-system"
      }
    ]
  },
  "dependencies": {
    "dexie": "^4.4.5",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.31.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.3",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.5",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-singlefile": "^2.3.3",
    "wait-on": "^9.1.0"
  }
}
